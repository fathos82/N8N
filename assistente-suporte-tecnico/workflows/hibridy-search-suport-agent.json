    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results;\nconst chunks = $('Setup chunks').first().json.chunks;\nconst minScore =  $('Settings').first().json.min_score_to_rank;\nconst sortedDocuments = results\n  .filter(r => r.relevance_score >= minScore)\n  .map(r => `[${r.relevance_score.toFixed(2)}] ${chunks[r.index].content}`);\n\nreturn [{ json: { sortedDocuments } }];"
      },
