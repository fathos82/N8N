    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst settings = $('Settings').first().json;\nconst topK = settings.top_k ?? 5;\nconst minScore = settings.min_score_to_expand ?? 0;\nconst hits = items.map(item => item.json);\n\nconst seen = new Set();\nconst toFetch = hits\n  .sort((a, b) => (b.rrf_score ?? 0) - (a.rrf_score ?? 0))\n  .filter(hit => (hit.rrf_score ?? 0) >= minScore)\n  .slice(0, topK)\n  .map(hit => ({\n    doc_id: hit.metadata.doc_id,\n    chunk_index: hit.metadata.chunk_index,\n    rrf_score: hit.rrf_score ?? 0\n  }))\n  .filter(f => {\n    const key = `${f.doc_id}_${f.chunk_index}`;\n    if (seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  });\n\nreturn [{ json: { hits, toFetch } }];"
      },
      "id": "43432bd3-131d-405a-babd-28ab895edb0e",
      "name": "Generate List do Context Expansion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2704,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const hits = $('Generate List do Context Expansion').first().json.hits ?? [];\nconst expanded = $input.all().map(i => i.json);\n\nconst all = [...hits, ...expanded];\n\nconst seen = new Set();\nconst chunks = all.filter(c => {\n  const key = `${c.metadata?.doc_id}_${c.metadata?.chunk_index}`;\n  if (seen.has(key)) return false;\n  seen.add(key);\n  return true;\n});\n\nreturn [{ json: { chunks } }];"
      },
